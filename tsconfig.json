{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs", 
    "moduleResolution": "node", 
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true, 
    "ignoreDeprecations": "6.0", 
  }, 
   "include": ["*.ts"],
  "exclude": ["node_modules", "dist"]
}